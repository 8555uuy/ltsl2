<Window x:Class="Itsl2.App.ModDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载中心 · itsl2" Height="680" Width="920"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="下载中心" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="从 Modrinth 搜索并安装模组到当前实例" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,24,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="38" Padding="12,8" FontSize="14" Text="JEI" VerticalContentAlignment="Center" />
            <TextBox x:Name="VersionBox" Grid.Column="1" Height="38" Padding="10,8" Margin="8,0,0,0" Text="1.20.1" VerticalContentAlignment="Center" />
            <ComboBox x:Name="LoaderBox" Grid.Column="2" Height="38" Margin="8,0,0,0" SelectedIndex="0">
                <ComboBoxItem Content="全部加载器" Tag="" />
                <ComboBoxItem Content="Fabric" Tag="fabric" />
                <ComboBoxItem Content="Forge" Tag="forge" />
                <ComboBoxItem Content="NeoForge" Tag="neoforge" />
            </ComboBox>
            <Button x:Name="SearchButton" Grid.Column="3" Content="⌕  搜索" Height="38" Padding="18,8" Margin="8,0,0,0" Background="{StaticResource BlueBrush}" Foreground="White" Click="Search_Click" />
        </Grid>
        <ListBox x:Name="ResultsList" Grid.Row="2" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding Downloads, StringFormat=下载量 {0:N0}}" Foreground="{StaticResource BlueDarkBrush}" FontSize="12" Margin="0,10,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="下载" Padding="18,8" VerticalAlignment="Center" Background="{StaticResource BlueBrush}" Foreground="White" Click="Download_Click" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <ProgressBar x:Name="DownloadProgress" Height="4" Visibility="Collapsed" IsIndeterminate="True" Foreground="{StaticResource BlueBrush}" />
            <TextBlock x:Name="StatusText" Text="输入关键词后开始搜索" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
        </Grid>
    </Grid>
</Window>