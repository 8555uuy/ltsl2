<Window x:Class="Itsl2.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="itsl2" Height="720" Width="1180"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#172A4D">
            <DockPanel Margin="18,24">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="itsl2" Foreground="White" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Minecraft 启动器" Foreground="#AFC4E8" FontSize="12" Margin="2,2,0,34" />
                    <TextBlock Text="工作台" Foreground="#7190BF" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,8" />
                    <Button Content="⌂  总览" HorizontalContentAlignment="Left" Background="#2F6FED" Foreground="White" />
                    <Button Content="▣  游戏实例" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#D9E4F7" Margin="0,6,0,0" />
                    <TextBlock Text="工具" Foreground="#7190BF" FontSize="11" FontWeight="SemiBold" Margin="4,24,0,8" />
                    <Button Content="⌁  联机大厅" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#D9E4F7" Margin="0,6,0,0" Click="Multiplayer_Click" />
                    <Button Content="↓  下载中心" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#D9E4F7" Margin="0,6,0,0" Click="DownloadCenter_Click" />
                    <Button Content="⚙  皮肤站登录" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#D9E4F7" Margin="0,6,0,0" Click="LoginAccount_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border BorderBrush="#38537F" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="运行环境" Foreground="#AFC4E8" FontSize="12" />
                            <TextBlock x:Name="JavaStatus" Text="正在检测 Java..." Foreground="White" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="AccountStatus" Text="未登录皮肤站" Foreground="#AFC4E8" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <Button Content="作者：8555uuy" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#7190BF" Padding="0" Margin="0,13,0,0" Click="CreatorInfo_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="38,32,44,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="总览" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="管理实例并快速启动 Minecraft" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="＋ 添加实例" HorizontalAlignment="Right" Background="{StaticResource BlueBrush}" Foreground="White" Click="AddInstance_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,28,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="实例数量" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="InstanceCount" Text="1" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="当前版本" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="CurrentVersion" Text="1.20.1" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="启动状态" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="LaunchStatus" Text="就绪" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{StaticResource BlueBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,14,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                            <TextBlock Text="我的实例" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="最近使用" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <ListBox x:Name="InstanceList" BorderThickness="0" SelectionChanged="InstanceList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12" Margin="0,0,0,8" BorderBrush="#E3E8F0" BorderThickness="1" Background="#FBFCFE" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" Background="#DCE8FF" CornerRadius="8">
                                                <TextBlock Text="◆" Foreground="{StaticResource BlueBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Version}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="就绪" Foreground="#29845A" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="#EAF1FF" CornerRadius="10" Padding="22">
                    <StackPanel>
                        <TextBlock Text="快速启动" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedInstanceName" Text="生存服实例" Foreground="{StaticResource BlueDarkBrush}" FontSize="16" Margin="0,22,0,4" />
                        <TextBlock x:Name="SelectedInstancePath" Text="尚未设置游戏目录" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <Button x:Name="LaunchButton" Content="▶  启动游戏" Background="{StaticResource BlueBrush}" Foreground="White" Margin="0,24,0,8" Height="40" Click="Launch_Click" />
                        <Button Content="⌖  配置游戏目录" Background="White" Foreground="{StaticResource BlueDarkBrush}" Margin="0,0,0,8" Click="ConfigureInstance_Click" />
                        <Button x:Name="DetectJavaButton" Content="⟳  检测 Java" Background="White" Foreground="{StaticResource BlueDarkBrush}" Click="DetectJava_Click" />
                        <ProgressBar x:Name="OperationProgress" Height="3" Margin="0,18,0,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource BlueBrush}" />
                        <TextBlock x:Name="ActionMessage" Text="选择实例后可以执行操作" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,20,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="▣  游戏目录" Background="White" Foreground="{StaticResource BlueDarkBrush}" Margin="0,0,4,0" Click="OpenGameDirectory_Click" />
                            <Button Content="◆  模组目录" Grid.Column="1" Background="White" Foreground="{StaticResource BlueDarkBrush}" Margin="4,0,0,0" Click="OpenModsDirectory_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>